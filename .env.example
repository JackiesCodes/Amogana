# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Mobile Network Operator (MNO) webhook secrets ---
ORANGE_MONEY_WEBHOOK_SECRET=replace-with-orange-money-hmac-secret
MYZAKA_WEBHOOK_SECRET=replace-with-myzaka-hmac-secret
SMEGA_WEBHOOK_SECRET=replace-with-smega-hmac-secret

# --- External merchant / broker webhook secrets ---
DERIV_WEBHOOK_SECRET=replace-with-deriv-hmac-secret
BET365_WEBHOOK_SECRET=replace-with-bet365-hmac-secret

# --- Platform ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
FX_SPREAD_BPS=75
